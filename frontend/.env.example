# ─── Frontend environment variables ─────────────────────────────────────────
# Copy this file to .env.development or .env.production and fill in the values.

# Backend base URL (without /api suffix — apiClient.ts adds /api automatically).
# Example: http://localhost:3000
VITE_API_URL=/api

# Set to "true" to use the in-browser mock (localStorage) instead of the real backend.
# No server is started — the mock runs entirely in the browser/Electron renderer.
VITE_USE_MOCK=true
